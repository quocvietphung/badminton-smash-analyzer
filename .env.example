AI_ASSISTANT_ENABLED=true
AZURE_RESOURCE_NAME=
AZURE_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=v1
AZURE_OPENAI_MODEL_LABEL=GPT-4.1 mini
AI_CHAT_MAX_OUTPUT_TOKENS=480
AI_RATE_LIMIT_SALT=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Local AI backend (Docker Compose, see docs/LOCAL_AI_TEST_REPORT.md).
# Server-side only: none of these may use a NEXT_PUBLIC_ prefix, because browser-visible variables are public.
# SMASHLAB_API_URL: the FastAPI backend as the studio server reaches it (local Docker by default).
SMASHLAB_API_URL=http://localhost:8000
# SMASHLAB_API_TOKEN: bearer token the studio server adds to backend calls. Set the same value on the backend.
SMASHLAB_API_TOKEN=
# SMASHLAB_PUBLIC_API_URL: HTTPS origin browsers upload to for a future remote setup. Empty = SMASHLAB_API_URL.
SMASHLAB_PUBLIC_API_URL=
# SMASHLAB_SITE_PASSWORD: turns on the studio sign-in. Leave empty for local development.
SMASHLAB_SITE_PASSWORD=
# SMASHLAB_SESSION_SECRET: at least 32 random characters. Required when SMASHLAB_SITE_PASSWORD is set.
SMASHLAB_SESSION_SECRET=
# SMASHLAB_WEB_PORT: the studio in Docker (Dockerfile.web), open http://localhost:3002.
SMASHLAB_WEB_PORT=3002
# AI Coach provider. Azure stays the default. SMASHLAB_COACH_PROVIDER=ollama sends the same derived metrics to an Ollama
# server on this computer; OLLAMA_BASE_URL must be an address of this computer (see docs/AI_COACH.md).
# SMASHLAB_COACH_PROVIDER=azure
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5-7b-8k
